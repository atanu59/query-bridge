# Copy this file to ".env" (in the backend folder) and fill in your own values.

# --- PostgreSQL connection ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop_db
DB_USER=postgres
DB_PASSWORD=your_database_password

# --- AI model (Google Gemini) ---
# Get a key at https://aistudio.google.com
AI_API_KEY=your_gemini_api_key
# Model names change over time. Copy a current Flash model name from Google AI Studio.
AI_MODEL=gemini-3.5-flash
